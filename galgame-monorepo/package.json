{
  "name": "sylvie-galgame",
  "version": "0.1.0",
  "private": true,
  "description": "Sylvie Galgame · YAML 驱动的视觉小说播放器（Electron + React + TypeScript Monorepo）",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @sylvie/player... --filter @sylvie/minigames... build && pnpm --filter @sylvie/electron start",
    "dev:web": "pnpm --filter @sylvie/web dev",
    "build": "turbo run build",
    "build:web": "pnpm --filter @sylvie/web build",
    "preview:web": "pnpm --filter @sylvie/web build && pnpm --filter @sylvie/web preview",
    "package": "pnpm --filter @sylvie/player... --filter @sylvie/minigames... build && pnpm --filter @sylvie/electron package",
    "make": "pnpm --filter @sylvie/player... --filter @sylvie/minigames... build && pnpm --filter @sylvie/electron make",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "assets": "node scripts/generate-assets.mjs",
    "validate": "node scripts/validate-content.mjs",
    "version:check": "node scripts/sync-version.mjs",
    "version:set": "node scripts/sync-version.mjs --set",
    "version:expect": "node scripts/sync-version.mjs --expect",
    "smoke": "node scripts/smoke-app.mjs",
    "smoke:web": "node scripts/smoke-web.mjs"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "prettier": "^3.4.2",
    "turbo": "^2.5.0",
    "yaml": "^2.9.1"
  }
}
