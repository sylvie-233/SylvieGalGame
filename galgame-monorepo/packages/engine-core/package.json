{
  "name": "@sylvie/engine-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sylvie Galgame 纯 TypeScript 业务内核：YAML 脚本解析、指令调度、变量、存档",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@sylvie/types": "workspace:*",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@sylvie/tsconfig": "workspace:*",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
