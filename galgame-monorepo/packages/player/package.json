{
  "name": "@sylvie/player",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sylvie Galgame React 播放器：分层舞台、对话、选项、存读档与设置（Web / Electron 共用）",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@sylvie/engine-core": "workspace:*",
    "@sylvie/types": "workspace:*",
    "@tsparticles/basic": "4.5.3",
    "@tsparticles/engine": "4.5.3",
    "@tsparticles/react": "4.5.3",
    "framer-motion": "^12.0.0",
    "howler": "^2.2.4",
    "motion": "^12.0.0",
    "zustand": "^5.0.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@sylvie/eslint-config": "workspace:*",
    "@sylvie/tsconfig": "workspace:*",
    "@types/howler": "^2.2.11",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.18.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
